# Shared database credentials used by docker-compose.yml.
# Copy this file to .env and change the password before using it anywhere real.
POSTGRES_DB=incident_investigator
POSTGRES_USER=incident
POSTGRES_PASSWORD=change-me

# Ports published on the host. The applications in docker-compose use the
# service names (postgres, simulator) rather than these host ports.
SIMULATOR_PORT=8081
ENGINE_PORT=8082
POSTGRES_PORT=5432

# Investigation budgets. These are the values the orchestrator enforces.
INVESTIGATION_MAX_STEPS=14
INVESTIGATION_MAX_TOOL_CALLS=12
INVESTIGATION_MAX_DURATION_SECONDS=120
INVESTIGATION_TOOL_TIMEOUT_MS=5000
